{
  "kind": "cli-file",
  "pov_kind": "cli-file",
  "steps": [
    {
      "role": "run",
      "argv": [
        "/src/haproxy/haproxy",
        "-f",
        "{poc}",
        "-d",
        "-q"
      ],
      "cwd": "/tmp/exploit_work",
      "stdin": null,
      "env": {
        "ASAN_OPTIONS": "detect_leaks=0"
      }
    }
  ],
  "poc_path": "/tmp/exploit_work/haproxy_chroot.cfg",
  "aux_files": {},
  "dirs": [
    "/tmp/exploit_work",
    "/tmp/exploit_work/jail"
  ],
  "oracle": {
    "type": "output-diff",
    "observe": [
      "status",
      "output"
    ],
    "timeout_is_observation": true,
    "limit_sec": 5,
    "normalize": [
      [
        "\\(\\d+\\)",
        "(PID)"
      ]
    ]
  },
  "touched_files": [
    "src/haproxy.c"
  ],
  "target_dir": "haproxy",
  "leak_task": false,
  "leak_detection": "off",
  "timeout_sec": 60,
  "compile_timeout_sec": 600,
  "cyberforge": {
    "project": "haproxy",
    "vulnerability_id": "vulnerability_WF_LLM_1",
    "pipeline": "WF_LLM"
  }
}
