{
  "kind": "cli-file",
  "pov_kind": "cli-file",
  "steps": [
    {
      "role": "run",
      "argv": [
        "/src/htslib/bgzip",
        "-d",
        "-c",
        "{poc}"
      ],
      "cwd": "/tmp/cf_poc",
      "stdin": null,
      "env": {
        "ASAN_OPTIONS": "detect_leaks=0"
      }
    }
  ],
  "poc_path": "/tmp/cf_poc/poc.bgz",
  "aux_files": {},
  "dirs": [
    "/tmp/cf_poc"
  ],
  "oracle": {
    "type": "match",
    "pattern": "Inflate operation failed"
  },
  "touched_files": [
    "bgzf.c",
    "test/test.pl"
  ],
  "target_dir": "htslib",
  "leak_task": false,
  "leak_detection": "off",
  "timeout_sec": 60,
  "compile_timeout_sec": 600,
  "cyberforge": {
    "project": "htslib",
    "vulnerability_id": "vulnerability_FZ_2",
    "pipeline": "FZ"
  }
}
