{
  "kind": "cli-file",
  "pov_kind": "harness",
  "steps": [
    {
      "role": "run",
      "argv": [
        "/out/fuzzerCellsToMultiPolygon",
        "{poc}"
      ],
      "cwd": "{run}",
      "env": {
        "ASAN_OPTIONS": "allocator_may_return_null=1:max_allocation_size_mb=64:detect_leaks=0"
      },
      "stdin": null
    }
  ],
  "poc_path": null,
  "aux_files": {},
  "dirs": [],
  "oracle": {
    "type": "crash",
    "frame_pattern": "createArcSet|cellsToMultiPolygon"
  },
  "touched_files": [
    "src/h3lib/lib/cellsToMultiPoly.c"
  ],
  "target_dir": "h3",
  "leak_task": false,
  "leak_detection": "off",
  "timeout_sec": 60,
  "compile_timeout_sec": 600,
  "no_ground_truth": {
    "why": "the dataset's input is 200M invalid H3 cells (reserved high bit set) that validateCellSet rejects before the changed code, and libFuzzer OOMs loading the 1.6 GB file on both builds; the injected NULL-check removal is reachable only when a calloc fails, which no dataset input arranges."
  },
  "cyberforge": {
    "project": "h3",
    "vulnerability_id": "vulnerability_WF_LLM_1",
    "pipeline": "WF_LLM"
  }
}
