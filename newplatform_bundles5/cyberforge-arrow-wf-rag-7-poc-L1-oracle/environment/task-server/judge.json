{
  "kind": "cli-file",
  "pov_kind": "driver",
  "steps": [
    {
      "role": "run",
      "argv": [
        "/cf_driver/driver",
        "{poc}"
      ],
      "cwd": "/tmp/cf_poc",
      "stdin": null,
      "env": {
        "ASAN_OPTIONS": "detect_leaks=0"
      }
    }
  ],
  "poc_path": "/tmp/cf_poc/numbers.txt",
  "aux_files": {},
  "dirs": [
    "/tmp/cf_poc"
  ],
  "oracle": {
    "type": "output-diff"
  },
  "touched_files": [
    "cpp/src/arrow/array/builder_nested.cc"
  ],
  "target_dir": "arrow",
  "leak_task": false,
  "leak_detection": "off",
  "timeout_sec": 60,
  "compile_timeout_sec": 600,
  "no_ground_truth": {
    "why": "the dataset exploit is a placeholder that only greps builder_nested.cc; nothing in the dataset ever called FixedSizeListBuilder::ValidateOverflow."
  },
  "cyberforge": {
    "project": "arrow",
    "vulnerability_id": "vulnerability_WF_RAG_7",
    "pipeline": "WF_RAG"
  }
}
