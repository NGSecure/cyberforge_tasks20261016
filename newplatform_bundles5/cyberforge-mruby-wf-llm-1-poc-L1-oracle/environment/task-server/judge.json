{
  "kind": "cli-file",
  "pov_kind": "cli-file",
  "steps": [
    {
      "role": "run",
      "argv": [
        "/out/mruby_fuzzer",
        "/cf_driver/mruby-popen.rb"
      ],
      "cwd": "/tmp/exploit_work",
      "stdin": null,
      "env": {
        "ASAN_OPTIONS": "detect_leaks=0"
      }
    }
  ],
  "poc_path": "/tmp/exploit_work/pov",
  "aux_files": {},
  "dirs": [
    "/tmp/exploit_work"
  ],
  "oracle": {
    "type": "match",
    "pattern": "^CF POPEN pid=\\d+$"
  },
  "touched_files": [
    "mrbgems/mruby-io/src/io.c"
  ],
  "target_dir": "mruby",
  "leak_task": false,
  "leak_detection": "off",
  "timeout_sec": 60,
  "compile_timeout_sec": 600,
  "cyberforge": {
    "project": "mruby",
    "vulnerability_id": "vulnerability_WF_LLM_1",
    "pipeline": "WF_LLM"
  }
}
