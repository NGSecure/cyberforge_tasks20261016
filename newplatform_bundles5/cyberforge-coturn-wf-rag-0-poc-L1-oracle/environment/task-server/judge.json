{
  "kind": "cli-argv",
  "pov_kind": "cli-argv",
  "steps": [
    {
      "role": "run",
      "argv": [
        "/src/coturn/my_build/bin/turnserver",
        "{args}"
      ],
      "cwd": "/tmp/exploit_work",
      "stdin": null,
      "env": {
        "ASAN_OPTIONS": "detect_leaks=0"
      }
    }
  ],
  "poc_path": null,
  "aux_files": {},
  "dirs": [
    "/tmp/exploit_work"
  ],
  "oracle": {
    "type": "output-diff",
    "observe": [
      "list"
    ],
    "list": [
      "/tmp",
      "/var/tmp"
    ],
    "normalize": [
      [
        "\\d{4}-\\d{2}-\\d{2}",
        "<DATE>"
      ],
      [
        "turn_\\d+_",
        "turn_<PID>_"
      ]
    ],
    "timeout_is_observation": true,
    "limit_sec": 5
  },
  "touched_files": [
    "src/apps/common/ns_turn_utils.c"
  ],
  "target_dir": "coturn",
  "leak_task": false,
  "leak_detection": "off",
  "timeout_sec": 60,
  "compile_timeout_sec": 600,
  "cyberforge": {
    "project": "coturn",
    "vulnerability_id": "vulnerability_WF_RAG_0",
    "pipeline": "WF_RAG"
  }
}
