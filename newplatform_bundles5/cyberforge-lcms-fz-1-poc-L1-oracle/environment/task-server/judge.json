{
  "kind": "cli-file",
  "pov_kind": "cli-file",
  "steps": [
    {
      "role": "run",
      "argv": [
        "/src/lcms/utils/psicc/psicc",
        "-i",
        "{poc}"
      ],
      "cwd": "/tmp/cf_poc",
      "stdin": null,
      "env": {
        "ASAN_OPTIONS": "detect_leaks=0"
      }
    }
  ],
  "poc_path": "/tmp/cf_poc/profile.icc",
  "aux_files": {},
  "dirs": [
    "/tmp/cf_poc"
  ],
  "oracle": {
    "type": "match",
    "pattern": "dup 1\\.1 gt \\{ pop 1\\.0 \\} if"
  },
  "touched_files": [
    "src/cmsps2.c"
  ],
  "target_dir": "lcms",
  "leak_task": false,
  "leak_detection": "off",
  "timeout_sec": 60,
  "compile_timeout_sec": 600,
  "no_ground_truth": {
    "why": "The exploit only greps the built liblcms2.a for the string 'dup 1.1 gt' and never runs lcms on any profile."
  },
  "cyberforge": {
    "project": "lcms",
    "vulnerability_id": "vulnerability_FZ_1",
    "pipeline": "FZ"
  }
}
