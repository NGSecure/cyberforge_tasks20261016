{
  "kind": "cli-file",
  "pov_kind": "driver",
  "steps": [
    {
      "role": "run",
      "argv": [
        "/cf_driver/driver",
        "{poc}"
      ],
      "cwd": "/tmp/cf_poc",
      "env": {
        "ASAN_OPTIONS": "detect_leaks=0:abort_on_error=1:halt_on_error=1",
        "LD_LIBRARY_PATH": "/out/lib"
      },
      "stdin": null
    }
  ],
  "poc_path": "/tmp/cf_poc/params.txt",
  "aux_files": {},
  "dirs": [
    "/tmp/cf_poc"
  ],
  "oracle": {
    "type": "crash"
  },
  "touched_files": [
    "libvips/iofuncs/buffer.c"
  ],
  "target_dir": "libvips",
  "leak_task": false,
  "leak_detection": "off",
  "timeout_sec": 120,
  "compile_timeout_sec": 600,
  "cyberforge": {
    "project": "libvips",
    "vulnerability_id": "vulnerability_WF_RAG_1",
    "pipeline": "WF_RAG"
  }
}
