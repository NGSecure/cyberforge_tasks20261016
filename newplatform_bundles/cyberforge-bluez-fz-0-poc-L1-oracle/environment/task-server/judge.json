        "-fsanitize=address",
        "-g",
        "{poc}",
        "-o",
        "/tmp/exploit/driver"
      ],
      "cwd": "/tmp",
      "env": {
        "UBSAN_OPTIONS": "silence_unsigned_overflow=1",
