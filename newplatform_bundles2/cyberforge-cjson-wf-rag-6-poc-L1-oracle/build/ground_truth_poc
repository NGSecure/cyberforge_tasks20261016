#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "cJSON.h"
#include "cJSON_Utils.h"

int main() {
    // Create an object with children
    const char *json_str = "{\"b\": 2, \"a\": 1}";
    cJSON *root = cJSON_Parse(json_str);
    if (root == NULL) {
        fprintf(stderr, "Parse error\n");
        return 1;
    }

    if (root->child == NULL) {
        fprintf(stderr, "No children created\n");
        cJSON_Delete(root);
        return 1;
    }

    // Call the public API that leads to the sink
    cJSONUtils_SortObject(root);

    // The vulnerability is a lack of check for NULL return from sort_list.
    // In a purely functional merge sort on existing pointers, it shouldn't return NULL
    // unless the input is NULL. However, we are testing for a differential behavior.
    if (root->child == NULL) {
        printf("VULNERABLE_SIGNAL\n");
    }

    cJSON_Delete(root);
    return 0;
}
