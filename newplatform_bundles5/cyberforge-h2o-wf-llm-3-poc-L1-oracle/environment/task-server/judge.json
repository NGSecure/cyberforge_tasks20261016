{
  "kind": "cli-file",
  "pov_kind": "cli-file",
  "steps": [
    {
      "role": "run",
      "argv": [
        "/out/h2o-fuzzer-url",
        "-rss_limit_mb=0",
        "{poc}"
      ],
      "cwd": "/out",
      "stdin": null,
      "env": {
        "ASAN_OPTIONS": "halt_on_error=1:detect_leaks=0"
      }
    }
  ],
  "poc_path": null,
  "aux_files": {},
  "dirs": [],
  "oracle": {
    "type": "crash"
  },
  "touched_files": [
    "lib/common/string.c"
  ],
  "target_dir": "h2o",
  "leak_task": false,
  "leak_detection": "off",
  "timeout_sec": 300,
  "compile_timeout_sec": 600,
  "decompress": "auto",
  "fsize_limit_mb": 4200,
  "no_ground_truth": {
    "why": "the exploit's payload (`http://a?` and NUL bytes to 4294967396 bytes; bzip2 -9: conversion/c5/gt/h2o/vulnerability_WF_LLM_3/payload.bin.bz2, 3,050 bytes) needs about 14 GB of memory to run, so the bundle does not carry it: build.sh's self-check would exhaust an ordinary machine"
  },
  "cyberforge": {
    "project": "h2o",
    "vulnerability_id": "vulnerability_WF_LLM_3",
    "pipeline": "WF_LLM"
  }
}
