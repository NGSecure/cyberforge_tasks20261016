{
  "kind": "cli-file",
  "pov_kind": "driver",
  "steps": [
    {
      "role": "run",
      "argv": [
        "/cf_driver/driver",
        "{poc}"
      ],
      "cwd": "/tmp/cf_poc",
      "stdin": null,
      "env": {
        "ASAN_OPTIONS": "detect_leaks=0"
      }
    }
  ],
  "poc_path": "/tmp/cf_poc/searchdir.txt",
  "aux_files": {
    "/tmp/exploit_work/ssd_trigger": "aux-0-ssd_trigger"
  },
  "dirs": [
    "/tmp/cf_poc",
    "/tmp/exploit_work"
  ],
  "oracle": {
    "type": "output-diff"
  },
  "touched_files": [
    "src/context.c"
  ],
  "target_dir": "libyang",
  "leak_task": false,
  "leak_detection": "off",
  "timeout_sec": 60,
  "compile_timeout_sec": 600,
  "aux_modes": {
    "/tmp/exploit_work/ssd_trigger": "0755"
  },
  "cyberforge": {
    "project": "libyang",
    "vulnerability_id": "vulnerability_WF_LLM_1",
    "pipeline": "WF_LLM"
  }
}
