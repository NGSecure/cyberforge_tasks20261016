{
  "kind": "cli-file",
  "pov_kind": "harness",
  "steps": [
    {
      "role": "run",
      "argv": [
        "/out/ssml-fuzzer",
        "{poc}"
      ],
      "cwd": "{run}",
      "env": {
        "ASAN_OPTIONS": "halt_on_error=1:abort_on_error=1:detect_leaks=0"
      },
      "stdin": null
    }
  ],
  "poc_path": null,
  "aux_files": {},
  "dirs": [],
  "oracle": {
    "type": "crash",
    "frame_pattern": "ProcessParamStack"
  },
  "touched_files": [
    "src/libespeak-ng/ssml.c"
  ],
  "target_dir": "espeak-ng",
  "leak_task": false,
  "leak_detection": "off",
  "timeout_sec": 60,
  "compile_timeout_sec": 600,
  "cyberforge": {
    "project": "espeak-ng",
    "vulnerability_id": "vulnerability_WF_LLM_3",
    "pipeline": "WF_LLM"
  }
}
