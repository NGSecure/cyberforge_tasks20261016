    "type": "crash"
  },
  "touched_files": [
    "guetzli/processor.cc"
  ],
  "target_dir": "guetzli",
  "leak_task": false,
  "leak_detection": "off",
  "timeout_sec": 60,
  "compile_timeout_sec": 600,
  "cyberforge": {
    "project": "guetzli",
    "vulnerability_id": "vulnerability_FZ_4",
    "pipeline": "FZ"
  }
