{
  "kind": "cli-argv",
  "pov_kind": "cli-argv",
  "steps": [
    {
      "role": "run",
      "argv": [
        "/src/h3/build/bin/h3",
        "{args}"
      ],
      "cwd": "/tmp/cf_poc",
      "stdin": null,
      "env": {
        "ASAN_OPTIONS": "detect_leaks=0"
      }
    }
  ],
  "poc_path": null,
  "aux_files": {},
  "dirs": [
    "/tmp/cf_poc"
  ],
  "oracle": {
    "type": "match",
    "pattern": "\\[-?\\d+\\.\\d+, -?\\d+\\.\\d+\\]"
  },
  "touched_files": [
    "src/apps/filters/h3.c"
  ],
  "target_dir": "h3",
  "leak_task": false,
  "leak_detection": "off",
  "timeout_sec": 60,
  "compile_timeout_sec": 600,
  "cyberforge": {
    "project": "h3",
    "vulnerability_id": "vulnerability_WF_LLM_5",
    "pipeline": "WF_LLM"
  }
}
