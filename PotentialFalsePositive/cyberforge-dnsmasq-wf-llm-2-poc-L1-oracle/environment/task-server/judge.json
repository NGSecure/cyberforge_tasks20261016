{
  "kind": "cli-file",
  "pov_kind": "cli-file",
  "steps": [
    {
      "role": "run",
      "argv": [
        "/src/dnsmasq/src/dnsmasq",
        "--port=0",
        "--no-daemon",
        "--conf-file=/dev/null"
      ],
      "cwd": "/tmp/exploit_work",
      "env": {
        "ASAN_OPTIONS": "detect_leaks=0",
        "LD_PRELOAD": "/cf_driver/urandom_shim.so"
      },
      "stdin": null
    }
  ],
  "poc_path": "/tmp/exploit_work/urandom_pov",
  "aux_files": {},
  "dirs": [
    "/tmp/exploit_work"
  ],
  "oracle": {
    "type": "output-diff",
    "timeout_is_observation": true,
    "limit_sec": 10
  },
  "touched_files": [
    "src/util.c"
  ],
  "target_dir": "dnsmasq",
  "leak_task": false,
  "leak_detection": "off",
  "timeout_sec": 60,
  "compile_timeout_sec": 600,
  "cyberforge": {
    "project": "dnsmasq",
    "vulnerability_id": "vulnerability_WF_LLM_2",
    "pipeline": "WF_LLM"
  }
}
