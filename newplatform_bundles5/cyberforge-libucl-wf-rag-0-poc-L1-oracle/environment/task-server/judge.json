{
  "kind": "cli-file",
  "pov_kind": "driver",
  "steps": [
    {
      "role": "run",
      "argv": [
        "/cf_driver/driver",
        "{poc}"
      ],
      "cwd": "/tmp/cf_poc",
      "stdin": null,
      "env": {
        "ASAN_OPTIONS": "halt_on_error=1:abort_on_error=1:detect_leaks=0"
      }
    }
  ],
  "poc_path": "/tmp/cf_poc/payload.bin",
  "aux_files": {},
  "dirs": [
    "/tmp/cf_poc"
  ],
  "oracle": {
    "type": "crash"
  },
  "touched_files": [
    "src/ucl_parser.c"
  ],
  "target_dir": "libucl",
  "leak_task": false,
  "leak_detection": "off",
  "timeout_sec": 60,
  "compile_timeout_sec": 600,
  "cyberforge": {
    "project": "libucl",
    "vulnerability_id": "vulnerability_WF_RAG_0",
    "pipeline": "WF_RAG"
  }
}
