#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#include <json.h>

int main() {
    struct json_object *jo = json_object_new_object();
    struct json_object *res = NULL;
    char path[512];
    memset(path, '/', 511);
    path[511] = '\0';
    
    // This calls json_pointer_get -> json_pointer_get_internal
    json_pointer_get(jo, path, &res);
    
    if (res) json_object_put(res);
    json_object_put(jo);
    return 0;
}
