{
  "kind": "cli-file",
  "pov_kind": "harness",
  "steps": [
    {
      "role": "run",
      "argv": [
        "/out/parquet-arrow-fuzz",
        "{poc}"
      ],
      "cwd": "{run}",
      "env": {
        "ASAN_OPTIONS": "detect_leaks=0"
      },
      "stdin": null
    }
  ],
  "poc_path": null,
  "aux_files": {},
  "dirs": [],
  "oracle": {
    "type": "crash"
  },
  "touched_files": [
    "cpp/src/arrow/flight/sql/server_session_middleware.cc"
  ],
  "target_dir": "arrow",
  "leak_task": false,
  "leak_detection": "off",
  "timeout_sec": 60,
  "compile_timeout_sec": 600,
  "no_ground_truth": {
    "why": "the changed file is Flight SQL code that the OSS-Fuzz build.sh never compiles (it builds no Flight/Flight-SQL), so the vulnerable and secure builds are byte-identical and no built program contains the injected change."
  },
  "cyberforge": {
    "project": "arrow",
    "vulnerability_id": "vulnerability_WF_RAG_4",
    "pipeline": "WF_RAG"
  }
}
