      "cwd": "/tmp",
      "env": {
        "UBSAN_OPTIONS": "silence_unsigned_overflow=1",
        "HWASAN_OPTIONS": "random_tags=0",
        "DFSAN_OPTIONS": "warn_unimplemented=0"
      },
      "stdin": null
    }
  ],
  "poc_path": "/tmp/exploit/driver.c",
  "aux_files": {},
  "dirs": [
    "/tmp/exploit"
  ],
  "touched_files": [
    "lib/bluetooth/bluetooth.h"
  ],
  "target_dir": "bluez",
  "leak_task": false,
  "leak_detection": "off: the injected bug is not a leak",
  "timeout_sec": 60,
  "compile_timeout_sec": 600,
  "normalized": [],
