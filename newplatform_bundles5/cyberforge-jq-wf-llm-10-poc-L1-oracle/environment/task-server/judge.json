{
  "kind": "archive",
  "pov_kind": "archive",
  "steps": [
    {
      "role": "run",
      "argv": [
        "/out/jq_fuzz_compile",
        "{input}"
      ],
      "cwd": "{dir}",
      "stdin": null,
      "env": {
        "ASAN_OPTIONS": "detect_leaks=0"
      }
    }
  ],
  "poc_path": null,
  "aux_files": {},
  "dirs": [],
  "oracle": {
    "type": "output-diff",
    "normalize": [
      [
        "(?m)^INFO: .*$",
        "<libFuzzer INFO>"
      ],
      [
        "(?m)^Executed .* in \\d+ ms$",
        "<libFuzzer executed>"
      ],
      [
        "(?m)^\\*\\*\\*.*$",
        "<libFuzzer note>"
      ],
      [
        "(?m)^Running: .*$",
        "<libFuzzer running>"
      ],
      [
        "(?m)^MERGE.*$",
        ""
      ],
      [
        "(?m)^#\\d+\\s+(INITED|DONE|RELOAD|pulse|NEW|REDUCE).*$",
        "<libFuzzer status>"
      ]
    ]
  },
  "touched_files": [
    "src/util.c"
  ],
  "target_dir": "jq",
  "leak_task": false,
  "leak_detection": "off",
  "timeout_sec": 60,
  "compile_timeout_sec": 600,
  "cyberforge": {
    "project": "jq",
    "vulnerability_id": "vulnerability_WF_LLM_10",
    "pipeline": "WF_LLM"
  }
}
