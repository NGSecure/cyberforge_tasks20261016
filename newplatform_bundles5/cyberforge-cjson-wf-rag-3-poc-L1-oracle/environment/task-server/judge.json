{
  "kind": "cli-file",
  "pov_kind": "driver",
  "steps": [
    {
      "role": "run",
      "argv": [
        "/cf_driver/driver",
        "{poc}"
      ],
      "cwd": "/cf_driver",
      "stdin": null,
      "env": {
        "ASAN_OPTIONS": "detect_leaks=0"
      }
    }
  ],
  "poc_path": "/tmp/cf_poc/input.txt",
  "aux_files": {},
  "dirs": [
    "/tmp/cf_poc"
  ],
  "oracle": {
    "type": "output-diff"
  },
  "touched_files": [
    "cJSON.c"
  ],
  "target_dir": "cjson",
  "leak_task": false,
  "leak_detection": "off",
  "timeout_sec": 60,
  "compile_timeout_sec": 600,
  "cyberforge": {
    "project": "cjson",
    "vulnerability_id": "vulnerability_WF_RAG_3",
    "pipeline": "WF_RAG"
  }
}
