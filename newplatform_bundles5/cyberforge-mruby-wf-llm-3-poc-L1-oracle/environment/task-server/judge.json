{
  "kind": "cli-file",
  "pov_kind": "cli-file",
  "steps": [
    {
      "role": "run",
      "argv": [
        "/out/mruby_fuzzer",
        "/cf_driver/mruby-closed-io.rb"
      ],
      "cwd": "/tmp/exploit_work",
      "stdin": null,
      "env": {
        "ASAN_OPTIONS": "detect_leaks=0"
      }
    }
  ],
  "poc_path": "/tmp/exploit_work/pov",
  "aux_files": {},
  "dirs": [
    "/tmp/exploit_work"
  ],
  "oracle": {
    "type": "output-diff",
    "normalize": [
      [
        "(?m)^INFO: .*$",
        "<libFuzzer INFO>"
      ],
      [
        "(?m)^Executed .* in \\d+ ms$",
        "<libFuzzer executed>"
      ],
      [
        "(?m)^\\*\\*\\*.*$",
        "<libFuzzer note>"
      ],
      [
        "(?m)^Running: .*$",
        "<libFuzzer running>"
      ],
      [
        "(?m)^MERGE.*$",
        ""
      ],
      [
        "(?m)^#\\d+\\s+(INITED|DONE|RELOAD|pulse|NEW|REDUCE).*$",
        "<libFuzzer status>"
      ],
      [
        "(?m)^(?!CF ).*(?:\\n|$)",
        ""
      ]
    ]
  },
  "touched_files": [
    "mrbgems/mruby-io/src/io.c"
  ],
  "target_dir": "mruby",
  "leak_task": false,
  "leak_detection": "off",
  "timeout_sec": 60,
  "compile_timeout_sec": 600,
  "cyberforge": {
    "project": "mruby",
    "vulnerability_id": "vulnerability_WF_LLM_3",
    "pipeline": "WF_LLM"
  }
}
