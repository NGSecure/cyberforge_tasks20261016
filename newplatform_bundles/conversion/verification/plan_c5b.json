  "project": "libsndfile",
  "generate": {
   "cmd": "set -e; d=$(mktemp -d); cat > \"$d/gen.c\" <<'EOF'\n/* the write half of tests/lossy_comp_test.c lcomp_test_short(\"g721.au\", SF_ENDIAN_LITTLE | SF_FORMAT_AU | SF_FORMAT_G721_32, 1, 0.7) (test au_g721) */\n#include <math.h>\n#include <string.h>\n#include <sndfile.h>\n#define BUFFER_SIZE (1 << 14)\n#define SAMPLE_RATE 11025\n#define DECAY_COUNT 1000\nstatic const char *long_comment =\n\t\"This is really quite a long comment. It is designed to be long enough \"\n\t\"to screw up the encoders and decoders if the file container format does \"\n\t\"not handle things correctly. If everything is working correctly, the \"\n\t\"decoder will only decode the actual audio data, and not this string at \"\n\t\"the end of the file.\" ;\nstatic double orig_d [BUFFER_SIZE + 1] ;\nstatic short orig [BUFFER_SIZE + 1] ;\nint main (int argc, char *argv [])\n{\tSF_INFO sfinfo ;\n\tSNDFILE *file ;\n\tint k, ramplen = DECAY_COUNT ;\n\tsf_count_t datalen = BUFFER_SIZE / 1 ;\n\tdouble amp = 0.0, scale = 32000.0 ;\n\tif (argc != 2) return 2 ;\n\tfor (k = 0 ; k < datalen ; k++)\t/* gen_signal_double (orig, 32000.0, 1, datalen) */\n\t{\tif (k <= ramplen)\n\t\t\tamp = scale * k / ((double) ramplen) ;\n\t\telse if (k > datalen - ramplen)\n\t\t\tamp = scale * (datalen - k) / ((double) ramplen) ;\n\t\torig_d [k] = amp * (0.4 * sin (33.3 * 2.0 * M_PI * ((double) (k+1)) / ((double) SAMPLE_RATE))\n\t\t\t\t\t\t+ 0.3 * cos (201.1 * 2.0 * M_PI * ((double) (k+1)) / ((double) SAMPLE_RATE))) ;\n\t\t} ;\n\tfor (k = 0 ; k < datalen ; k++)\n\t\torig [k] = (short) (orig_d [k]) ;\n\tmemset (&sfinfo, 0, sizeof (sfinfo)) ;\n\tsfinfo.samplerate = SAMPLE_RATE ;\n\tsfinfo.frames = 123456789 ;\n\tsfinfo.channels = 1 ;\n\tsfinfo.format = SF_ENDIAN_LITTLE | SF_FORMAT_AU | SF_FORMAT_G721_32 ;\n\tif ((file = sf_open (argv [1], SFM_WRITE, &sfinfo)) == NULL) return 1 ;\n\tif (sf_writef_short (file, orig, datalen) != datalen) return 1 ;\n\tsf_set_string (file, SF_STR_COMMENT, long_comment) ;\n\tsf_close (file) ;\n\treturn 0 ;\n}\nEOF\nclang -fsanitize=address -I/src/libsndfile/include \"$d/gen.c\" /src/libsndfile/src/.libs/libsndfile.a -lm -o \"$d/gen\"\nASAN_OPTIONS=detect_leaks=0 \"$d/gen\" /cf_gt_out/lct_g721.au\nrm -rf \"$d\"",
   "name": "lct_g721.au",
   "out": "/home/user/cyberforge_tasks20261016/newplatform_bundles/conversion/c5/gt/libsndfile/vulnerability_FZ_0/lct_g721.au",
   "label": "constructed c5/gt/libsndfile/vulnerability_FZ_0/lct_g721.au"
  }
