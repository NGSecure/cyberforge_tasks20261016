{
  "kind": "cli-file",
  "pov_kind": "harness",
  "steps": [
    {
      "role": "run",
      "argv": [
        "/out/FuzzStun",
        "{poc}"
      ],
      "cwd": "{run}",
      "env": {
        "ASAN_OPTIONS": "detect_leaks=0"
      },
      "stdin": null
    }
  ],
  "poc_path": null,
  "aux_files": {},
  "dirs": [],
  "oracle": {
    "type": "crash"
  },
  "touched_files": [
    "src/apps/common/stun_buffer.c"
  ],
  "target_dir": "coturn",
  "leak_task": false,
  "leak_detection": "off",
  "timeout_sec": 60,
  "compile_timeout_sec": 600,
  "no_ground_truth": {
    "why": "The exploit only greps stun_buffer.c and echoes a made-up UBSAN line, and the changed return value is never used, so no input can show it."
  },
  "cyberforge": {
    "project": "coturn",
    "vulnerability_id": "vulnerability_WF_RAG_5",
    "pipeline": "WF_RAG"
  }
}
