{
  "kind": "cli-file",
  "pov_kind": "driver",
  "steps": [
    {
      "role": "run",
      "argv": [
        "/cf_driver/driver",
        "{poc}"
      ],
      "cwd": "/tmp/cf_poc",
      "stdin": null,
      "env": {
        "ASAN_OPTIONS": "detect_leaks=0"
      }
    }
  ],
  "poc_path": "/tmp/cf_poc/dynbuf.txt",
  "aux_files": {},
  "dirs": [
    "/tmp/cf_poc"
  ],
  "oracle": {
    "type": "output-diff"
  },
  "touched_files": [
    "cutils.c"
  ],
  "target_dir": "quickjs",
  "leak_task": false,
  "leak_detection": "off",
  "timeout_sec": 60,
  "compile_timeout_sec": 600,
  "cyberforge": {
    "project": "quickjs",
    "vulnerability_id": "vulnerability_WF_LLM_2",
    "pipeline": "WF_LLM"
  }
}
